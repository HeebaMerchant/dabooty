rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{id} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if true;
    }
    match /files/{id} {
      allow read: if true;
      allow create, update: if request.resource.size < 25 * 1024 * 1024
        && request.resource.size > 0;
      allow delete: if true;
    }
  }
}
